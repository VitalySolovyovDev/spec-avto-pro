{
  "name": "specteh-pro",
  "private": true,
  "scripts": {
    "predev": "kill-port 3000 3001",
    "dev": "concurrently \"npm run dev --prefix frontend\" \"npm run dev --prefix backend\"",
    "build": "npm run build --prefix frontend && npm run build --prefix backend",
    "start": "node backend/dist/server.js",
    "deploy:upload": "node scripts/deploy.js",
    "check-engines": "node scripts/check-engines.js",
    "deploy": "npm run build && npm run deploy:upload",
    "smoke:prod": "playwright test scripts/debug/prod-smoke.spec.js --workers=1",
    "telegram:webhook": "node scripts/set-telegram-webhook.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.1.0",
    "dotenv": "^17.3.1",
    "kill-port": "^2.0.1",
    "semver": "^7.4.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  }
}
